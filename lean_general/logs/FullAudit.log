def VietorisOrdinals.K.{u} : (X : Type u) → [inst : TopologicalSpace X] → Type (max 0 u) :=
fun X [TopologicalSpace X] => { f // IsCompact (range f) }
def VietorisOrdinals.basic.{u} : (X : Type u) → Set X → Finset ℕ → (ℕ → Set X) → Set (ℕ → X) :=
fun X U F V => {f | range f ⊆ U ∧ ∀ i ∈ F, f i ∈ V i}
def VietorisOrdinals.generators.{u} : (X : Type u) → [inst : TopologicalSpace X] → Set (Set (ℕ → X)) :=
fun X [TopologicalSpace X] => {A | ∃ U F V, IsOpen U ∧ (∀ i ∈ F, IsOpen (V i)) ∧ A = basic X U F V}
def VietorisOrdinals.powerTopology.{u} : (X : Type u) → [inst : TopologicalSpace X] → TopologicalSpace (ℕ → X) :=
fun X [TopologicalSpace X] => TopologicalSpace.generateFrom (generators X)
def VietorisOrdinals.kTopology.{u} : (X : Type u) → [inst : TopologicalSpace X] → TopologicalSpace (K X) :=
fun X [TopologicalSpace X] => TopologicalSpace.induced (fun f => ↑f) (powerTopology X)
