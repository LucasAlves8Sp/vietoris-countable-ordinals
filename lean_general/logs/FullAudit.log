def VietorisOrdinals.MainClaim.{u} : (X : Type u) → [inst : TopologicalSpace X] → Prop :=
fun X [TopologicalSpace X] => SecondCountableTopology (K X) ∧ IsLindelof univ ∧ ¬IsSigmaCompact univ
def VietorisOrdinals.Menger.{u} : (Y : Type u) → [inst : TopologicalSpace Y] → Prop :=
fun Y [TopologicalSpace Y] =>
  ∀ (U : ℕ → Set (Set Y)),
    (∀ (n : ℕ), ∀ s ∈ U n, IsOpen s) →
      (∀ (n : ℕ) (x : Y), ∃ s ∈ U n, x ∈ s) → ∃ F, (∀ (n : ℕ), ∀ s ∈ F n, s ∈ U n) ∧ ∀ (x : Y), ∃ n, ∃ s ∈ F n, x ∈ s
